# Optional: your Reown / WalletConnect Cloud project ID for production traffic.
# If unset, RainbowKit uses its built-in demo project for development.
# https://cloud.reown.com/
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Hardhat — Sepolia deploy (never commit real keys)
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# DEPLOYER_PRIVATE_KEY=0x...
# ETHERSCAN_API_KEY=...

# Sepolia UI (public contract addresses after deploy)
# NEXT_PUBLIC_ESCROW_ADDRESS=0x...
# NEXT_PUBLIC_MOCK_USDT_ADDRESS=0x...

# Optional: OpenExchangeRates (higher limits); otherwise free open.er-api.com is used
# OPEN_EXCHANGE_RATES_APP_ID=
